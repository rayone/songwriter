# Template: deploy/install.sh --service fills the @...@ placeholders and installs
# the result to /etc/systemd/system/songwriter.service. Do not install by hand.
[Unit]
Description=Songwriter web server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@SONGWRITER_HOME@
EnvironmentFile=@SONGWRITER_HOME@/deploy/.env
Environment=HOME=@SONGWRITER_DATA_DIR@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@SONGWRITER_HOME@/.venv/bin/python -m songwriter.web
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Sandbox: the code tree is read-only; only the data directory is writable.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=@SONGWRITER_DATA_DIR@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX


[Install]
WantedBy=multi-user.target
